@startuml MCD_Systeme_Vehicules_Raph
!define TABLE(name) class name << (T,#FFAAAA) >>
!define ENTITY(name) class name << (E,#AAFFAA) >>

title Diagramme Entité-Association - Responsabilité Raph

' ============ ENTITÉS ============
ENTITY(Client) {
  + id : Long <<PK>>
  --
  nom : String
  email : String
  telephone : String
  type : String
}

ENTITY(Societe) {
  + client_id : Long <<PK,FK>>
  --
  siret : String <<UNIQUE>>
  raisonSociale : String
  capital : Double
}

ENTITY(Particulier) {
  + client_id : Long <<PK,FK>>
  --
  prenom : String
  civilite : String
}

ENTITY(Commande) {
  + id : Long <<PK>>
  --
  numeroCommande : String <<UNIQUE>>
  dateCreation : Date
  montantTotal : Double
  montantTaxe : Double
  paysLivraison : String
  tauxTaxeApplique : Double
  etat : String
}

ENTITY(Vehicule) {
  + id : Long <<PK>>
  --
  modele : String
  marque : String
  prixBase : Double
  dateAjoutStock : Date
  enStock : Boolean
  pourcentageSolde : Double
}

ENTITY(LigneCommande) {
  + id : Long <<PK>>
  --
  quantite : Integer
  prixUnitaire : Double
  sousTotal : Double
}

' ============ RELATIONS ============
Client "1" -- "*" Commande : passe
Societe "1" -- "*" Client : a pour filiale
Client "*" -- "1" Societe : appartient à

Commande "1" -- "*" LigneCommande : contient
LigneCommande "*" -- "1" Vehicule : concerne

' ============ HÉRITAGE ============
Client <|-- Societe
Client <|-- Particulier

' ============ NOTES ============
note top of Societe
  <b>COMPOSITE PATTERN</b>
  Une société peut contenir
  d'autres clients (filiales)
end note

note right of Commande
  <b>TEMPLATE METHOD</b>
  tauxTaxeApplique varie selon
  le pays (FR, BE, US...)
end note

note left of Vehicule
  <b>COMMAND PATTERN</b>
  pourcentageSolde peut être
  modifié/annulé via Command
end note

@enduml
